{
  "expo": {
    "name": "MOVVA",
    "slug": "movva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.movva",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O MOVVA usa sua localização para gravar o percurso dos seus treinos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.movva"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O MOVVA acessa suas fotos para você adicionar imagens aos seus posts e treinos.",
          "cameraPermission": "O MOVVA usa a câmera para você tirar fotos dos seus treinos."
        }
      ]
    ],
    "scheme": "movva",
    "experiments": {
      "typedRoutes": true
    }
  }
}